APP_NAME="Balafon Broadcast Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
BALAFON_OVERLAY_BASE_URL=http://127.0.0.1:8080
APP_TIMEZONE=Europe/Paris

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=balafon
DB_USERNAME=balafon
DB_PASSWORD=balafon

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@balafon.local"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080,localhost:5173,127.0.0.1:5173

VMIX_DRIVER=real
VMIX_TICKER_TITLE_PATH="C:\Program Files (x86)\vMix\titles\GT Ticker\Ticker 3- Clear.gtzip"
VMIX_TICKER_TEXT_INDEX=0
VMIX_HOST=host.docker.internal
VMIX_PORT=8088
VMIX_TIMEOUT_MS=3000
VMIX_CONNECTION_NAME="vMix local"
BALAFON_AUTOMATION_PREPARE_THRESHOLD_MS=2000
BALAFON_AUTOMATION_TRANSITION_LEAD_MS=250
BALAFON_CONTAINER_WORKSPACE_PATH=/var/www/html
BALAFON_HOST_WORKSPACE_PATH=
BALAFON_HOST_MEDIA_ROOT=./storage/app
BALAFON_CONTAINER_MEDIA_ROOT=/media-library
BALAFON_MEDIA_BROWSER_ROOTS=/media-library
BALAFON_MEDIA_HOST_BROWSER_ROOTS=

SYSTEM_CPU_CORES=4
VITE_PORT=5173

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
