APP_NAME="Balafon Broadcast Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
BALAFON_OVERLAY_BASE_URL=http://127.0.0.1:8080
APP_TIMEZONE=Europe/Paris

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=1

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE is set by scripts/install_windows_local.ps1

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@balafon.local"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8080,localhost:8080

VMIX_DRIVER=real
VMIX_TICKER_TITLE_PATH='C:\Program Files (x86)\vMix\titles\GT Ticker\Ticker 3- Clear.gtzip'
VMIX_TICKER_TEXT_INDEX=0
VMIX_HOST=127.0.0.1
VMIX_PORT=8088
VMIX_TIMEOUT_MS=3000
VMIX_CONNECTION_NAME="vMix local"

BALAFON_CONTAINER_WORKSPACE_PATH=
BALAFON_HOST_WORKSPACE_PATH=
BALAFON_HOST_MEDIA_ROOT=
BALAFON_CONTAINER_MEDIA_ROOT=
BALAFON_MEDIA_BROWSER_ROOTS=
BALAFON_MEDIA_HOST_BROWSER_ROOTS=

SYSTEM_CPU_CORES=4
VITE_PORT=5174

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
